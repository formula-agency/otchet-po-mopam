# Центральная MongoDB-конфигурация. Сам tenant намеренно не настраивается:
# приложение всегда выбирает только tenant_tag=formula.
MONGO_CALLS_CONFIG_URI=
MONGO_CALLS_CONFIG_DATABASE=mongo_calls
MONGO_CALLS_CONFIG_COLLECTION=customers
MOP_CALL_SOURCE=mongodb
# false допускается только потому, что текущий tenant-конфиг использует admin:root;
# код отчета при этом по-прежнему предоставляет только read API.
MONGO_CALLS_REQUIRE_SERVER_READ_ONLY=true
MONGO_CALLS_REQUIRED=true
MONGO_CALLS_FALLBACK_TO_BITRIX=false
MONGO_CALLS_AGGREGATION_TIMEOUT_MS=120000
MONGO_CALLS_CONNECT_TIMEOUT_MS=5000
# Необязательный локальный endpoint SSH-туннеля, например 127.0.0.1:27018.
MONGO_CALLS_ENDPOINT_OVERRIDE=
